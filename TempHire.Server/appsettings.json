{
  "ConnectionStrings": {
    "TempHire": "Server=(localdb)\\MSSQLLocalDB;Database=TempHire;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "TempHireIdentity": "Server=(localdb)\\MSSQLLocalDB;Database=TempHireIdentity;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "AllowedClientOrigins": [ "http://localhost:4200", "https://localhost:4200" ],
  "Agent": {
    "Provider": "Ollama",
    "MaxToolCalls": 8,
    "Ollama": {
      "Endpoint": "http://127.0.0.1:11434",
      "Model": "qwen3:4b-instruct"
    },
    "Claude": {
      "Model": "claude-sonnet-5-5",
      "MaxTokens": 4096
    },
    // Quinn's budgets, in US dollars, per model (see QuinnQuotaRule).  Each question is recorded at
    // its cost from the rule's Prices, which must match the provider's price list.  A typical Quinn
    // question with Claude Sonnet 5.5 is ~5,400 tokens, ~95% of them input: about $0.013 at the full
    // input price.  Prompt caching reads most of that input from the cache at a twentieth of the
    // price: about $0.010 for a first question and $0.006 for a follow-up.  The cache prices are the
    // provider's, for 5-minute cache writes; a rule without them charges reads at the input price
    // and writes at 1.25 times it.
    // The company's monthly limit is the budget; the daily and weekly limits, and the user's, keep one
    // day or one user from using it all.  A null limit is no limit.
    "Quotas": [
      {
        "Provider": "Claude",
        "Model": "claude-sonnet-5-5",
        "Prices": { "InputPerMillion": 2.00, "OutputPerMillion": 10.00, "CacheReadPerMillion": 0.10, "CacheWritePerMillion": 2.50 },
        "User": { "Daily": 0.50, "Weekly": 1.25, "Monthly": 3.00 },
        "Tenant": { "Daily": 1.50, "Weekly": 4.00, "Monthly": 10.00 },
        "Tenants": {}
      },
      {
        // Any other Claude model, until it has a rule of its own: charged at the highest Claude price,
        // so switching models can't make Quinn free or overspend the budget.
        "Provider": "Claude",
        "Prices": { "InputPerMillion": 10.00, "OutputPerMillion": 50.00, "CacheReadPerMillion": 0.50, "CacheWritePerMillion": 12.50 },
        "User": { "Daily": 0.50, "Weekly": 1.25, "Monthly": 3.00 },
        "Tenant": { "Daily": 1.50, "Weekly": 4.00, "Monthly": 10.00 }
      },
      {
        "Provider": "Ollama",
        "User": { "Daily": null, "Weekly": null, "Monthly": null },
        "Tenant": { "Daily": null, "Weekly": null, "Monthly": null }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
