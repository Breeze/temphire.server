<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>TempHire.Server</RootNamespace>
    <UserSecretsId>f0a1f8fc-e269-4df9-a4af-e12a9d3befae</UserSecretsId>
    <!-- The /// comments, for Swagger (see Swagger/SwaggerSetup.cs).  Not every member has one: no
         warning for those (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Breeze: the direct replacement for the DevForce server-side runtime. -->
    <PackageReference Include="Anthropic" Version="13.8.0" />
    <PackageReference Include="Breeze.AspNetCore.NetCore" Version="8.0.0" />
    <!-- The validation framework: a local build in packages/ until it is published (see nuget.config). -->
    <PackageReference Include="IdeaBlade.Validation" Version="0.1.0-preview.10" />
    <PackageReference Include="Breeze.Persistence.EFCore" Version="8.0.0" />
    <!-- Breeze serializes entities with Json.NET, so MVC has to as well. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="OllamaSharp" Version="5.5.2" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.9.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TempHire.Model\TempHire.Model.csproj" />
  </ItemGroup>

</Project>
